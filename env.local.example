# IMPORTANT: copy to .env.local (with a leading dot)
#   cp env.local.example .env.local
# Next.js does NOT read env.local or env.local.example — only .env.local
#
# Apps Script deploy: Who has access = "Anyone" (NOT "Anyone with a Google account")

NEXT_PUBLIC_GOOGLE_DRIVE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
NEXT_PUBLIC_GOOGLE_DRIVE_UPLOAD_TOKEN=same-secret-as-UPLOAD_TOKEN-in-Code.gs

# RSVP rows are appended via the same Apps Script — set RSVP_SPREADSHEET_ID in google-drive/Code.gs,
# redeploy the web app, then run testAppendRsvp once in the script editor to authorize Sheets.

# GitHub Pages (optional locally — CI sets these automatically)
# Project site: https://USER.github.io/REPO/ → NEXT_PUBLIC_BASE_PATH=/REPO
# User site repo USER.github.io → leave BASE_PATH empty
# NEXT_PUBLIC_BASE_PATH=/wedding
# NEXT_PUBLIC_SITE_URL=https://USER.github.io/wedding/
